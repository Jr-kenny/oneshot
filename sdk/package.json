{
  "name": "@oneshot-guard/sdk",
  "version": "0.1.2",
  "description": "OneShot \u2014 execution integrity for AI agents. One decision. One shot.",
  "homepage": "https://github.com/Jr-kenny/oneshot",
  "bugs": {
    "url": "https://github.com/Jr-kenny/oneshot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jr-kenny/oneshot.git",
    "directory": "sdk"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "near-api-js": "^7.4.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.14.0"
  }
}